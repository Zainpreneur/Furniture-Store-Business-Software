# SQLite (default, zero-setup dev database)
DATABASE_URL="file:./dev.db"

# To use PostgreSQL in production instead, set e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/furniture_store"
# ...and change the datasource "provider" in prisma/schema.prisma from "sqlite" to "postgresql".

PORT=4000
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
